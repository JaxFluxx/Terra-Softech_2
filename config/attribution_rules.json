{
  "version": 3,
  "identity": {
    "primary_route": {
      "booking_fields": [
        "client_name",
        "booking_lead_id"
      ],
      "referral_fields": [
        "client_name",
        "referral_lead_id"
      ],
      "label": "Exact client + lead_id"
    },
    "secondary_routes": [
      {
        "name": "Exact encrypted mobile",
        "referral_key": "referral_mobile_key",
        "booking_key": "booking_mobile_key"
      },
      {
        "name": "Exact encrypted email",
        "referral_key": "referral_email_key",
        "booking_key": "booking_email_key"
      }
    ],
    "secondary_route_changes_primary_count": false
  },
  "time": {
    "referral_field": "referral_submitted_on",
    "booking_fallback_order": [
      "booking_date_at",
      "booking_created_at"
    ],
    "allow_referral_on_booking_date": true,
    "latest_prior_referral": true,
    "attribution_windows_days": [
      30,
      60,
      90,
      180
    ],
    "primary_window_days": null,
    "reverse_time_class": "Data Integrity - Reverse Time"
  },
  "honored": {
    "primary_mode": "strict",
    "strict": {
      "normalized_field": "booking_source_norm",
      "accepted_values": [
        "REFERRAL"
      ],
      "label": "Booking source recorded as REFERRAL"
    }
  },
  "filters": {
    "test_demo_enabled": true,
    "test_demo_name_fields": {
      "referrals": [
        "lead_name",
        "referrer_name"
      ],
      "bookings": [
        "lead_name"
      ]
    },
    "test_demo_pattern": "\\b(?:test|demo|dummy|sample|training|internal)\\b|(?:^|[\\s_-])test[a-z0-9_-]*",
    "strong_test_demo_enabled": false,
    "strong_test_demo_signals": {
      "referrals": [],
      "bookings": [
        {
          "field": "booking_crm_id",
          "match": "regex",
          "pattern": "^DEMO-",
          "label": "Booking CRM ID starts with DEMO-"
        },
        {
          "field": "booking_unit_number",
          "match": "exact",
          "values": [
            "TEST"
          ],
          "label": "Unit number equals TEST"
        }
      ]
    }
  },
  "quality": {
    "value_sanity": {
      "repeated_digit_min_length": 6,
      "missing_label": "Not available",
      "non_positive_label": "Non-positive value",
      "repeated_digit_label": "Repeated-digit pattern",
      "positive_label": "Positive contextual value"
    }
  },
  "classification": {
    "tier_a": {
      "requires_single_referrer": true,
      "requires_no_timeline_ambiguity": true,
      "label": "Tier A - Strong attribution review"
    },
    "tier_b": {
      "trigger_any": [
        "multiple_referrer",
        "timeline_ambiguity"
      ],
      "label": "Tier B - Ambiguous attribution review"
    },
    "tier_c": {
      "identity_confirmation_required": true,
      "label": "Tier C - Secondary identity review"
    },
    "primary_case_class": "Primary attribution review",
    "secondary_case_class": "Secondary identity review",
    "reverse_time_case_class": "Reverse-time data integrity",
    "ops_priorities": {
      "reverse_time": {
        "label": "P0 - Repair chronology",
        "order": 0
      },
      "primary_review": {
        "label": "P1 - Verify attribution",
        "order": 1
      },
      "secondary_review": {
        "label": "P2 - Confirm identity",
        "order": 2
      }
    }
  },
  "process": {
    "sensitivity_windows_days": [
      30,
      60,
      90,
      180
    ],
    "multi_referrer": {
      "recommended_policy_id": "P-MANUAL",
      "manual_referrer_threshold": 2,
      "policies": [
        {
          "policy_id": "P-LAST",
          "label": "Latest prior referrer owns",
          "mode": "latest",
          "notes": "Detection reference only; does not prove ownership."
        },
        {
          "policy_id": "P-FIRST",
          "label": "First prior referrer owns",
          "mode": "first",
          "notes": "Alternative chronology rule; does not prove ownership."
        },
        {
          "policy_id": "P-MANUAL",
          "label": "Manual review for multiple prior referrers",
          "mode": "manual_when_multiple",
          "notes": "Recommended 90-day provisional policy."
        },
        {
          "policy_id": "P-SAME-PROJECT-LAST",
          "label": "Latest same-project referrer owns",
          "mode": "same_project_latest",
          "notes": "Same project is a helpful signal, not proof of ownership."
        }
      ]
    },
    "booking_warning": {
      "window_days": 30,
      "prior_referrer_display_cap": 5,
      "event_name": "booking_referral_history_warning",
      "event_version": "1.0",
      "trigger_when_source_not_in": [
        "REFERRAL"
      ],
      "single_same_project_action": "Soft warning + show owner candidate",
      "multiple_same_project_action": "Soft warning + required override reason + manual review",
      "cross_project_only_action": "Low-severity warning + event log; no automatic payout",
      "no_prior_referral_action": "No warning",
      "phase_2_action": "Consider a hard stop only after pilot evidence supports it",
      "event_fields": [
        "event_name",
        "event_version",
        "booking_id",
        "user_id",
        "booking_source_proposed",
        "referral_history_snapshot",
        "policy_id",
        "warning_shown",
        "warning_severity",
        "override_reason_code",
        "override_reason_free_text",
        "prior_referrer_count",
        "window_days",
        "decision",
        "timestamp"
      ]
    }
  },
  "regression": {
    "accepted_week5_baseline": {
      "metrics": {
        "eligible_bookings": 12,
        "strict_honored": 8,
        "primary_review": 4,
        "tier_a": 0,
        "tier_b": 4,
        "tier_c": 3,
        "reverse_time_source_disagreement": 28,
        "time_valid_same_enquiry_strict_unhonored": 0
      },
      "primary_review_booking_ids": [
        "1206",
        "935",
        "3331",
        "4913"
      ]
    },
    "strong_signal_sensitivity": {
      "metrics": {
        "eligible_bookings": 11,
        "strict_honored": 7,
        "primary_review": 4,
        "tier_a": 0,
        "tier_b": 4,
        "tier_c": 3,
        "reverse_time_source_disagreement": 28,
        "time_valid_same_enquiry_strict_unhonored": 0
      },
      "primary_review_booking_ids": [
        "1206",
        "935",
        "3331",
        "4913"
      ]
    },
    "intentional_difference": "The default package preserves the accepted Week 5 baseline. Strong test/demo signals remain visible as a data-quality sensitivity and must not change the primary funnel unless a data owner explicitly enables them. When enabled, they remove five additional booking rows and produce 11 eligible / 7 strict honored / 4 primary review; the four primary review booking IDs remain unchanged."
  },
  "outputs": {
    "directory": "data/derived"
  }
}
